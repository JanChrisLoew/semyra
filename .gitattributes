* text=auto

# Rust & Web-Quellcode konsistent mit LF im Index speichern
*.rs     text eol=lf
*.toml   text eol=lf
*.ts     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf

# Windows-spezifische Installer-Skripte mit CRLF auschecken
*.ps1    text eol=crlf
*.iss    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Binärdateien
*.ico    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
